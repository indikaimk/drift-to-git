apiVersion: v1
kind: Secret
metadata:
  name: drift-to-git-secret
  namespace: argocd
type: Opaque
stringData:
  # GitHub Personal Access Token (classic with 'repo' scope or fine-grained with read/write to Contents & Pull Requests)
  GITHUB_TOKEN: "ghp_your_github_token_here"
  
  # Optional: Argo CD API Auth Token (if authentication is required)
  ARGOCD_AUTH_TOKEN: ""
